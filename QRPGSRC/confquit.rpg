     FPOPUPS  CF  E                    WORKSTN
      *** PARAMETRE RECU / RENVOYE A L APPELANT
     C           *ENTRY    PLIST
     C                     PARM           SANSW   1
      *** AFFICHAGE FENETRE JUSQU A F3 OU F12
     C           *IN03     DOWEQ'0'
     C           *IN12     ANDEQ'0'
     C                     EXFMTWQUIT
     C                     ENDDO
      *** TRADUCTION DE LA TOUCHE EN REPONSE
     C           *IN03     IFEQ '1'
     C                     MOVE 'O'       SANSW
     C                     ELSE
     C                     MOVE 'N'       SANSW
     C                     ENDIF
     C                     SETON                         LR
