             PGM
             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DIR)  TYPE(*CHAR) LEN(50)
             DCL        VAR(&PATH) TYPE(*CHAR) LEN(100)
             DCL        VAR(&MSG)  TYPE(*CHAR) LEN(150)
             RTVJOBA    USER(&USER)

             CHGVAR     VAR(&DIR) VALUE('/home/' *TCAT &USER)
             MKDIR      DIR(&DIR)
             MONMSG     MSGID(CPFA0A0)

             CHGVAR     VAR(&PATH) VALUE(&DIR *TCAT '/BONBON.csv')

             CPYTOIMPF  FROMFILE(QUEMIN/BONBON BONBON) +
                          TOSTMF(&PATH) +
                          MBROPT(*REPLACE) STMFCCSID(1252) +
                          RCDDLM(*CRLF) DTAFMT(*DLM) +
                          STRDLM(*NONE) FLDDLM(';') +
                          DECPNT(*COMMA) ADDCOLNAM(*SYS)

             CHGVAR     VAR(&MSG) VALUE('Fichier' *BCAT &PATH *TCAT +
                          ' cree.')
             SNDPGMMSG  MSG(&MSG)
             ENDPGM
